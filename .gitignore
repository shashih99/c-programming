# VS Code — keep shared debug config; ignore local/editor noise
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
.vscode/build/

# Build directories
build/
**/build/
**/Debug/
**/Release/

# Compiled files
*.o
*.obj
*.exe
*.out
*.a
*.so
*.dylib

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Executables
outDebug
a.out

# Editor backup files
*~
*.swp
*.swo
.DS_Store

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Temporary files
*.tmp
*.log

