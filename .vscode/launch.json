{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current program",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/build/Debug/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "preLaunchTask": "${defaultBuildTask}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "stopAtEntry": false,
      "externalConsole": false,
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": {
        "hidden": false,
        "group": "1_default",
        "order": 1
      },
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
