{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current program",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/build/Debug/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "preLaunchTask": "Build current program (debug)",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "stopAtEntry": false,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
