{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build current program (debug)",
      "type": "shell",
      "command": "make",
      "args": ["debug"],
      "options": {
        "cwd": "${fileDirname}",
        "env": {}
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
